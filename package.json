{
  "name": "fuxian",
  "version": "0.1.0",
  "private": true,
  "description": "A focused desktop reader for polished Markdown documents.",
  "homepage": "https://github.com/def-peter/fuxian#readme",
  "bugs": {
    "url": "https://github.com/def-peter/fuxian/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/def-peter/fuxian.git"
  },
  "license": "UNLICENSED",
  "author": "def-peter",
  "type": "module",
  "main": "./apps/desktop/out/main/index.js",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @fuxian/desktop run postinstall",
    "dev": "pnpm --filter @fuxian/desktop dev",
    "build": "pnpm -r --if-present build",
    "package:dir": "pnpm build && electron-builder --dir --publish never",
    "package:mac": "pnpm build && electron-builder --mac dmg --publish never",
    "package:win": "pnpm build && electron-builder --win nsis --publish never",
    "prototype:theme": "pnpm --filter @fuxian/desktop exec vite prototypes/theme-shell --host 127.0.0.1",
    "verify:package": "node scripts/verify-packaged-app.mjs release",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm build && playwright test",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.0.8",
    "@playwright/test": "^1.62.1",
    "@types/node": "26.3.0",
    "axe-core": "^4.13.0",
    "electron-builder": "^26.0.12",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "pdfjs-dist": "^6.2.108",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
